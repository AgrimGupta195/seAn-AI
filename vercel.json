{
  "framework": null,
  "buildCommand": "npm install && npm install --prefix frontend && npm install --prefix backend && npm run build:frontend",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.js": {
      "includeFiles": ["backend/**/*"]
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/frontend/dist/$1" }
  ]
}

