# ============================================
# REQUIRED ENVIRONMENT VARIABLES FOR VERCEL
# ============================================

# Database Configuration
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key

# Pinecone Configuration
PINECONE_API_KEY=your-pinecone-api-key

# AWS S3 Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_BUCKET_NAME=your-s3-bucket-name

# Python Service (deploy separately and update URL)
PYTHON_SERVICE_URL=https://your-python-service.vercel.app

# ============================================
# OPTIONAL ENVIRONMENT VARIABLES
# ============================================

# CORS Configuration
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CLIENT_URL=https://yourdomain.com

# Frontend API Base URL (for Vite)
VITE_API_BASE_URL=/api

# Node Environment
NODE_ENV=production

# Port (auto-set by Vercel, but can override)
PORT=5000

# ============================================
# VERCEL AUTO-SET VARIABLES (don't set manually)
# ============================================
# VERCEL_URL - automatically set by Vercel
# VERCEL_BRANCH_URL - automatically set by Vercel
# VERCEL - automatically set to "1" on Vercel