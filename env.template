# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/sean-ai
# Or for MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/dbname

# JWT Secret Key (use a strong random string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# OpenAI API Key
OPENAI_API_KEY=sk-your-openai-api-key-here

# Pinecone API Key
PINECONE_API_KEY=your-pinecone-api-key-here

# AWS S3 Configuration
AWS_REGION=us-east-1
AWS_BUCKET_NAME=your-s3-bucket-name
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# Frontend API Base URL (optional - defaults to http://localhost:5000/api)
# For Docker Compose, you can leave this as default or set to: http://localhost:5000/api
# For production, set to your backend URL: https://your-backend-domain.com/api
VITE_API_BASE_URL=http://localhost:5000/api

